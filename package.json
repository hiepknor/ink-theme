{
  "name": "@hiepknor/ink-theme",
  "version": "0.2.0",
  "description": "A square, monochrome, high-density theme for Tailwind CSS v4.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./patterns.css": "./src/patterns.css",
    "./strict.css": "./src/strict.css",
    "./scoped-strict.css": "./src/scoped-strict.css"
  },
  "files": ["src", "README.md", "API.md", "MIGRATION.md", "DESIGN.md", "GALLERY.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "check": "node scripts/check-theme.mjs",
    "dev": "vite --config examples/gallery/vite.config.js",
    "build": "vite build --config examples/gallery/vite.config.js",
    "test": "node --test",
    "pack:check": "node scripts/check-package.mjs",
    "verify": "pnpm run check && pnpm test && pnpm build && pnpm pack:check"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
