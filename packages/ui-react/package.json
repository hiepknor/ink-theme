{
  "name": "@hiepknor/ink-ui-react",
  "version": "0.1.0",
  "description": "Accessible React components for the Ink design system.",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "repository": {
    "type": "git",
    "url": "https://github.com/hiepknor/ink-theme.git",
    "directory": "packages/ui-react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check-source.mjs",
    "test": "vitest run",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@hiepknor/ink-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
