{
  "$schema": "../token-schema.json",
  "tokens": {
    "color": {
      "primitive": {
        "white": "#ffffff",
        "gray50": "#f6f6f6",
        "gray100": "#f2f2f2",
        "gray200": "#e2e2e2",
        "gray600": "#6b6b6b",
        "gray700": "#565656",
        "black": "#111111"
      },
      "semantic": {
        "background": "{color.primitive.white}",
        "surface": "{color.primitive.white}",
        "elevated": "{color.primitive.gray100}",
        "recessed": "{color.primitive.gray50}",
        "border": "{color.primitive.gray200}",
        "borderStrong": "{color.primitive.black}",
        "foreground": "{color.primitive.black}",
        "foregroundMuted": "{color.primitive.gray700}",
        "foregroundSubtle": "{color.primitive.gray600}",
        "action": "{color.primitive.black}",
        "actionInk": "{color.primitive.white}",
        "focus": "{color.primitive.black}",
        "selection": "{color.primitive.black}",
        "selectionInk": "{color.primitive.white}",
        "statusOk": "{color.primitive.black}",
        "statusWarning": "{color.primitive.black}",
        "statusDanger": "{color.primitive.black}"
      }
    },
    "dimension": {
      "borderWidth": { "default": "1px", "strong": "2px" },
      "spacing": { "none": "0px", "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "2xl": "32px" },
      "controlHeight": { "compact": "32px", "default": "40px", "touch": "48px" },
      "radius": { "none": "0px" }
    },
    "typography": {
      "fontFamily": {
        "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
        "mono": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
      },
      "fontSize": { "sm": "14px", "md": "16px", "lg": "20px" },
      "fontWeight": { "regular": 400, "medium": 500, "bold": 700 },
      "lineHeight": { "tight": 1.2, "normal": 1.5 }
    },
    "motion": {
      "duration": { "instant": "0ms", "fast": "100ms", "normal": "160ms" },
      "easing": { "standard": "linear" }
    },
    "shadow": {
      "lift": "2px 2px 0 {color.primitive.black}",
      "liftStrong": "3px 3px 0 {color.primitive.black}",
      "inset": "inset 2px 2px 0 {color.primitive.gray200}"
    },
    "density": {
      "compact": { "controlHeight": "{dimension.controlHeight.compact}" },
      "default": { "controlHeight": "{dimension.controlHeight.default}" },
      "touch": { "controlHeight": "{dimension.controlHeight.touch}" }
    }
  },
  "tailwind": {
    "color-bg": "{color.semantic.background}",
    "color-surface": "{color.semantic.surface}",
    "color-elevated": "{color.semantic.elevated}",
    "color-recessed": "{color.semantic.recessed}",
    "color-line": "{color.semantic.border}",
    "color-line-strong": "{color.semantic.borderStrong}",
    "color-fg": "{color.semantic.foreground}",
    "color-fg-2": "{color.semantic.foregroundMuted}",
    "color-fg-3": "{color.semantic.foregroundSubtle}",
    "color-accent": "{color.semantic.action}",
    "color-accent-ink": "{color.semantic.actionInk}",
    "color-focus": "{color.semantic.focus}",
    "color-selection": "{color.semantic.selection}",
    "color-selection-ink": "{color.semantic.selectionInk}",
    "color-ok": "{color.semantic.statusOk}",
    "color-warn": "{color.semantic.statusWarning}",
    "color-danger": "{color.semantic.statusDanger}",
    "font-sans": "{typography.fontFamily.sans}",
    "font-mono": "{typography.fontFamily.mono}",
    "shadow-ink": "{shadow.lift}",
    "shadow-ink-strong": "{shadow.liftStrong}",
    "shadow-ink-inset": "{shadow.inset}",
    "radius-none": "{dimension.radius.none}",
    "radius-sm": "{dimension.radius.none}",
    "radius-md": "{dimension.radius.none}",
    "radius-lg": "{dimension.radius.none}",
    "radius-xl": "{dimension.radius.none}",
    "radius-2xl": "{dimension.radius.none}",
    "radius-3xl": "{dimension.radius.none}",
    "radius-full": "{dimension.radius.none}"
  },
  "native": {
    "colors": "{color.semantic}",
    "spacing": "{dimension.spacing}",
    "controlHeight": "{dimension.controlHeight}",
    "borderWidth": "{dimension.borderWidth}",
    "fontSize": "{typography.fontSize}",
    "fontWeight": "{typography.fontWeight}",
    "lineHeight": "{typography.lineHeight}",
    "motionDuration": "{motion.duration}"
  },
  "allowedColors": ["#ffffff", "#f6f6f6", "#f2f2f2", "#e2e2e2", "#6b6b6b", "#565656", "#111111"]
}
