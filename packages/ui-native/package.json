{
  "name": "@hiepknor/ink-ui-native",
  "version": "0.1.0",
  "description": "Accessible React Native components for the Ink design system.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-boundary.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@hiepknor/ink-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76 <1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
