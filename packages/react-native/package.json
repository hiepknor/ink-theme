{
  "name": "@hiepknor/ink-react-native",
  "version": "1.0.0",
  "description": "Accessible React Native components for the Ink design system.",
  "homepage": "https://github.com/hiepknor/ink-ui#readme",
  "bugs": {
    "url": "https://github.com/hiepknor/ink-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiepknor/ink-ui.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "CHANGELOG.md", "MIGRATION.md", "LICENSE"],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/check-boundary.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@hiepknor/ink-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.78 <1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
