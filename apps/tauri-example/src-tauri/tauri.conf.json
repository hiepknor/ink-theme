{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ink Desktop Example",
  "version": "0.1.0",
  "identifier": "com.hiepknor.ink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Ink Desktop Example", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
